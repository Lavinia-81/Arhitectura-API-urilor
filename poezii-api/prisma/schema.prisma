generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Author {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  bio       String?
  birthYear Int?
  deathYear Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  poems     Poem[]
}

model Poem {
  id         Int      @id @default(autoincrement())
  title      String
  slug       String   @unique
  summary    String?
  year       Int?
  type       PoemType @default(LYRIC)
  keywords   String?
  popularity Int      @default(0)
  authorId   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  fullText   String?
  author     Author   @relation(fields: [authorId], references: [id])
}

model ApiKey {
  id        String     @id @default(cuid())
  prefix    String
  keyHash   String     @unique
  plan      Plan       @default(FREE)
  createdAt DateTime   @default(now())
  expiresAt DateTime?
  lastUsed  DateTime?
  usageLogs UsageLog[]
}

model UsageLog {
  id        String   @id @default(cuid())
  apiKeyId  String
  endpoint  String
  method    String
  status    Int
  ipHash    String
  createdAt DateTime @default(now())
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id])
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum PoemType {
  EPIC
  LYRIC
  DRAMATIC
  EPISTOLARY
}
